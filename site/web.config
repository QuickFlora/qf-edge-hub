<?xml version="1.0" encoding="utf-8"?>
<!--
  qf-edge-hub (AB#3958, epic AB#3961). Deployed as its own IIS application + app pool.
  ConnectionString is filled in ON THE SERVER by deploy\install-hub.ps1 (copied from the print web
  service's own web.config) and is never committed. HubKey empty = any shop PC may connect (same as the
  print web service today); set a value and give it to the print app (HKCU\Software\QuickfloraPrinting\EdgeHubKey)
  to require it.
-->
<configuration>
  <appSettings>
    <add key="owin:AppStartup" value="QfEdgeHub.Startup, QfEdgeHub" />
    <add key="owin:AutomaticAppStartup" value="true" />
    <add key="ConnectionString" value="__SET_ON_SERVER__" />
    <add key="PrintServiceUrl" value="https://web1test.quickflora-dev.com/NewQFPrintWebService/QFPrintService.asmx" />
    <add key="PrintServiceHost" value="" />
    <add key="HubKey" value="" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" requestValidationMode="2.0" enableVersionHeader="false" />
    <customErrors mode="On" />
    <trace enabled="false" />
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
    <directoryBrowse enabled="false" />
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Owin" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.3.0" newVersion="4.2.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Owin.Security" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.3.0" newVersion="4.2.3.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
